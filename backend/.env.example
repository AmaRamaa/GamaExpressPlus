# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/gama_express?schema=public"
# Only needed against Supabase: a direct (non-pooled) connection for `prisma
# migrate deploy`, since its PgBouncer pool can't provide the session locks
# Migrate needs. See the datasource comment in prisma/schema.prisma.
DIRECT_URL="postgresql://user:password@localhost:5432/gama_express?schema=public"

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STAFF_PIN_CODE=
# Shared secret the external label-printing service sends as
# "Authorization: Bearer <value>" when it POSTs to /api/print-events.
PRINT_SERVICE_API_KEY=

# Payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Storage
# no longer used, replaced by Supabase Storage below
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SUPABASE_URL=https://odskekxcabzbfpyqkmkh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Gama Express <no-reply@gamaexpress.com>"
CONTACT_EMAIL_TO=GamaExpress18@gmail.com

# Maps
GOOGLE_MAPS_API_KEY=
