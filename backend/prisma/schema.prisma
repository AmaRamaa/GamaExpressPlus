// Gama Express — Auto Parts Platform
// Prisma schema: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────
// ENUMS
// ────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  BUSINESS
  WAREHOUSE_STAFF
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
  RETURN_REQUESTED
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  BANK_TRANSFER
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG
  CNG
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  CVT
  DUAL_CLUTCH
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  BACKORDER
  DISCONTINUED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum QuoteStatus {
  REQUESTED
  QUOTED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Language {
  SQ // Albanian
  EN
}

enum SubmissionStatus {
  PENDING   // created, AI screening hasn't finished (or AI is unavailable)
  REJECTED  // AI decided this isn't a real car part
  APPROVED  // AI confirmed it's a car part, awaiting an admin to promote it
  PROMOTED  // an admin turned it into a real Product
}

// ────────────────────────────────────────────────────────────
// USERS & ACCOUNTS
// ────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String?
  googleId          String?   @unique
  firstName         String
  lastName          String
  phone             String?
  role              Role      @default(CUSTOMER)
  emailVerified     Boolean   @default(false)
  emailVerifyToken  String?
  passwordResetToken String?
  passwordResetExpires DateTime?
  preferredLanguage Language  @default(SQ)
  preferredCurrency String    @default("EUR")

  // Business account fields
  isBusinessAccount Boolean   @default(false)
  companyName       String?
  companyRegNumber  String?
  vatNumber         String?
  wholesaleTier     String?   // e.g. "TIER_1", "TIER_2"
  wholesaleDiscountPct Float? @default(0)

  addresses         Address[]
  vehicles          SavedVehicle[]
  wishlist          WishlistItem[]
  cartItems         CartItem[]
  orders            Order[]
  reviews           Review[]
  quotes            QuoteRequest[]
  searchHistory     SearchHistory[]
  notifications     Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Address {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  label        String   // "Home", "Warehouse - Prishtinë", etc.
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  postalCode   String?
  country      String   @default("Kosovo")
  isDefault    Boolean  @default(false)
  isBilling    Boolean  @default(false)
  isShipping   Boolean  @default(true)
  createdAt    DateTime @default(now())

  orders Order[]
}

// ────────────────────────────────────────────────────────────
// VEHICLE CATALOG (Make / Model / Generation / Engine)
// ────────────────────────────────────────────────────────────

model VehicleMake {
  id     String  @id @default(cuid())
  name   String  @unique // "Volkswagen"
  slug   String  @unique
  logoUrl String?
  models VehicleModel[]
}

model VehicleModel {
  id        String   @id @default(cuid())
  make      VehicleMake @relation(fields: [makeId], references: [id])
  makeId    String
  name      String   // "Golf"
  slug      String
  generations VehicleGeneration[]

  @@unique([makeId, slug])
}

model VehicleGeneration {
  id          String   @id @default(cuid())
  model       VehicleModel @relation(fields: [modelId], references: [id])
  modelId     String
  name        String   // "Mk7 (2012–2020)"
  yearFrom    Int
  yearTo      Int?
  bodyType    String?  // "Hatchback", "Estate"
  engines     VehicleEngine[]
  savedBy     SavedVehicle[]

  @@index([modelId])
}

model VehicleEngine {
  id             String   @id @default(cuid())
  generation     VehicleGeneration @relation(fields: [generationId], references: [id])
  generationId   String
  engineCode     String   // "CRBC"
  displacementL  Float    // 2.0
  fuelType       FuelType
  horsePowerHp   Int
  transmission   TransmissionType
  yearFrom       Int
  yearTo         Int?

  compatibleProducts ProductCompatibility[]
  savedVehicles      SavedVehicle[]

  @@index([generationId])
}

// A customer's saved vehicle ("my garage")
model SavedVehicle {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  nickname     String?  // "My daily driver"
  generation   VehicleGeneration @relation(fields: [generationId], references: [id])
  generationId String
  engine       VehicleEngine? @relation(fields: [engineId], references: [id])
  engineId     String?
  vin          String?
  plateNumber  String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// ────────────────────────────────────────────────────────────
// CATALOG: CATEGORIES / BRANDS / MANUFACTURERS / PRODUCTS
// ────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  parentId    String?
  children    Category[] @relation("CategoryTree")
  products    Product[]
  sortOrder   Int      @default(0)

  @@index([parentId])
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique // "Bosch", "Brembo", "Febi Bilstein"
  slug     String    @unique
  logoUrl  String?
  isOEM    Boolean   @default(false)
  products Product[]
}

model Manufacturer {
  id      String   @id @default(cuid())
  name    String   @unique // Vehicle OEM manufacturer, e.g. "Volkswagen AG"
  slug    String   @unique
  logoUrl String?

  products Product[]
}

model Product {
  id                String   @id @default(cuid())
  sku               String   @unique
  slug              String   @unique
  title             String
  shortDescription  String?
  description       String?  @db.Text
  technicalInfo     String?  @db.Text
  installationNotes String?  @db.Text

  // Auto-translated counterpart of title/shortDescription/description --
  // whichever language the product was originally entered in is recorded
  // here so the storefront can pick the right side for the visitor's
  // chosen locale. Populated by the AI translation service, never
  // admin-writable directly.
  contentLanguage            Language?
  titleTranslated            String?
  shortDescriptionTranslated String?
  descriptionTranslated      String?  @db.Text

  category      Category @relation(fields: [categoryId], references: [id])
  categoryId    String
  brand         Brand    @relation(fields: [brandId], references: [id])
  brandId       String
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])
  manufacturerId String?

  oemNumbers    String[] // Cross-referenced OEM part numbers
  partNumber    String
  manufacturerNumber String?
  barcode       String?

  priceEur        Float
  discountPriceEur Float?
  costEur         Float?   // internal cost, admin only
  vatRatePct      Float    @default(18)

  weightKg      Float?
  dimensionsCm  String?  // "20x15x8"

  stockStatus   StockStatus @default(IN_STOCK)
  stockQuantity Int      @default(0)
  lowStockThreshold Int  @default(0)
  warehouseStock WarehouseStock[]

  isFeatured    Boolean  @default(false)
  isActive      Boolean  @default(true)
  isPerformancePart Boolean @default(false)

  // Which company physically holds/sells this part -- defaults to Gama
  // Express itself, but lets admins flag parts held by a partner company.
  locationCompany String @default("Gama Express SH.P.K")

  images        ProductImage[]
  compatibility ProductCompatibility[]
  reviews       Review[]
  wishlistedBy  WishlistItem[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  relatedTo     ProductRelation[] @relation("BaseProduct")
  relatedFrom   ProductRelation[] @relation("RelatedProduct")

  seoTitle       String?
  seoDescription String?

  createdByDevice String? // set when created via the staff PIN flow, not a real user account

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([manufacturerId])
  @@index([partNumber])
  @@index([sku])
}

model ProductImage {
  id          String  @id @default(cuid())
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  url         String
  // Set only once a background-removal pass has replaced `url` with a
  // processed version -- lets the original be restored non-destructively
  // and lets the bulk tool skip images it's already processed.
  originalUrl String?
  altText     String?
  sortOrder   Int     @default(0)
}

// Many-to-many: product <-> vehicle engine fitment
model ProductCompatibility {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  engine    VehicleEngine @relation(fields: [engineId], references: [id], onDelete: Cascade)
  engineId  String
  notes     String?

  @@unique([productId, engineId])
}

model ProductRelation {
  id               String  @id @default(cuid())
  baseProduct      Product @relation("BaseProduct", fields: [baseProductId], references: [id], onDelete: Cascade)
  baseProductId    String
  relatedProduct   Product @relation("RelatedProduct", fields: [relatedProductId], references: [id], onDelete: Cascade)
  relatedProductId String
  relationType     String  // "RELATED" | "FREQUENTLY_BOUGHT_TOGETHER"

  @@unique([baseProductId, relatedProductId, relationType])
}

model Review {
  id        String       @id @default(cuid())
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  user      User         @relation(fields: [userId], references: [id])
  userId    String
  rating    Int          // 1-5
  title     String?
  comment   String?      @db.Text
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@index([productId])
}

// ────────────────────────────────────────────────────────────
// INVENTORY / WAREHOUSES / SUPPLIERS
// ────────────────────────────────────────────────────────────

model Warehouse {
  id       String   @id @default(cuid())
  name     String   // "Gama Express - Prishtinë Central"
  address  String
  city     String
  lat      Float?
  lng      Float?
  isPickupLocation Boolean @default(true)
  stock    WarehouseStock[]
}

model WarehouseStock {
  id          String    @id @default(cuid())
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId String
  product     Product   @relation(fields: [productId], references: [id])
  productId   String
  quantity    Int       @default(0)
  binLocation String?   // shelf/aisle code

  @@unique([warehouseId, productId])
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactEmail  String?
  contactPhone  String?
  country       String?
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id         String   @id @default(cuid())
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  supplierId String
  status     String   @default("DRAFT") // DRAFT | SENT | RECEIVED | CANCELLED
  items      PurchaseOrderItem[]
  createdAt  DateTime @default(now())
  expectedAt DateTime?
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCostEur     Float
}

// ────────────────────────────────────────────────────────────
// CART / WISHLIST / COMPARISON
// ────────────────────────────────────────────────────────────

model CartItem {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  quantity  Int      @default(1)
  savedForLater Boolean @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ────────────────────────────────────────────────────────────
// ORDERS / PAYMENTS / INVOICES
// ────────────────────────────────────────────────────────────

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique // "GE-2026-000123"
  user           User          @relation(fields: [userId], references: [id])
  userId         String
  shippingAddress Address      @relation(fields: [shippingAddressId], references: [id])
  shippingAddressId String

  status         OrderStatus   @default(PENDING)
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(UNPAID)
  stripePaymentIntentId String?
  paypalOrderId  String?

  subtotalEur    Float
  discountEur    Float         @default(0)
  shippingEur    Float         @default(0)
  vatEur         Float         @default(0)
  totalEur       Float

  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])
  discountCodeId String?

  items          OrderItem[]
  invoice        Invoice?
  trackingNumber String?
  trackingCarrier String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderNumber])
}

model OrderItem {
  id          String  @id @default(cuid())
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product @relation(fields: [productId], references: [id])
  productId   String
  quantity    Int
  unitPriceEur Float
  totalEur    Float
}

model Invoice {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id])
  orderId     String   @unique
  invoiceNumber String @unique
  pdfUrl      String?
  issuedAt    DateTime @default(now())
}

model DiscountCode {
  id           String       @id @default(cuid())
  code         String       @unique
  type         DiscountType
  value        Float        // percentage or fixed amount
  minSpendEur  Float?
  maxUsesTotal Int?
  maxUsesPerUser Int?       @default(1)
  validFrom    DateTime
  validTo      DateTime
  isActive     Boolean      @default(true)
  orders       Order[]
}

// ────────────────────────────────────────────────────────────
// QUOTES (bulk / wholesale)
// ────────────────────────────────────────────────────────────

model QuoteRequest {
  id          String      @id @default(cuid())
  user        User        @relation(fields: [userId], references: [id])
  userId      String
  status      QuoteStatus @default(REQUESTED)
  items       QuoteItem[]
  notes       String?
  quotedTotalEur Float?
  createdAt   DateTime    @default(now())
  respondedAt DateTime?
}

model QuoteItem {
  id             String       @id @default(cuid())
  quote          QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId        String
  productId      String
  quantity       Int
  quotedUnitPriceEur Float?
}

// ────────────────────────────────────────────────────────────
// SEARCH / MISC
// ────────────────────────────────────────────────────────────

model SearchHistory {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  query     String
  createdAt DateTime @default(now())

  @@index([userId])
}

model PartRequest {
  // "Request unavailable parts"
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  vehicleInfo String?
  partDescription String @db.Text
  oemNumber   String?
  status      String   @default("OPEN") // OPEN | SOURCING | FULFILLED | CLOSED
  createdAt   DateTime @default(now())
}

// A part a customer/visitor offers to sell to the shop, submitted from the
// public /sell-part page. Deliberately its own model rather than an inactive
// Product row: it carries fields a real Product never needs (submitter
// contact info, the AI's raw car-part verdict) and is missing ones a real
// Product always needs (brand, category, price, partNumber) -- an admin
// fills those in when promoting it via the normal product form. No relation
// to Product: promotedProductId is just an id, so this table stays fully
// independent of the (already large) Product model.
model ProductSubmission {
  id                String           @id @default(cuid())
  createdAt         DateTime         @default(now())
  submitterName     String
  submitterEmail    String
  submitterPhone    String?
  title             String
  description       String?          @db.Text
  images            String[]
  status            SubmissionStatus @default(PENDING)
  aiIsCarPart       Boolean?
  aiReasoning       String?          @db.Text
  promotedProductId String?
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
}

model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String?
  content   String   @db.Text
  coverImageUrl String?
  isPublished Boolean @default(false)
  publishedAt DateTime?
  createdAt DateTime @default(now())
}
